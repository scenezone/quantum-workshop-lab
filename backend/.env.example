APP_ENV=development
LOG_LEVEL=INFO

# Leave MONGODB_URI empty for a simulator-only workshop without a database.
# Hardware jobs, feedback, and facilitator sessions then stay disabled.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=quantum_workshop
MONGODB_TIMEOUT_MS=5000

CORS_ORIGINS=http://localhost:5173

# Real hardware remains disabled until quotas and credentials are verified.
IBM_HARDWARE_ENABLED=false
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_INSTANCE=
# Optional account pool (JSON); when set, this replaces the single key above.
# Example: [{"name":"primary","api_key":"...","instance":"..."},{"name":"backup","api_key":"..."}]
IBM_QUANTUM_ACCOUNTS=
IBM_MAX_DAILY_JOBS=25
IBM_MAX_ACTIVE_JOBS=3
IBM_MAX_SHOTS=4096

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_REQUESTS_PER_MINUTE=10

MAX_SIMULATOR_SHOTS=10000
DEFAULT_SHOTS=1024
# Use Redis storage for deployments with multiple workers or instances.
RATE_LIMIT_STORAGE_URI=memory://
JOB_POLL_SECONDS=15
JOB_RETENTION_DAYS=7
LLM_TIMEOUT_SECONDS=25
MONGODB_CONNECT_ATTEMPTS=5

# Facilitator dashboard and feedback export (at least 16 characters; empty disables them).
ADMIN_TOKEN=
# Days to keep anonymous feedback; 0 keeps it until an operator removes it.
FEEDBACK_RETENTION_DAYS=0
# Workshop session codes and participant progress expire after this many hours.
SESSION_RETENTION_HOURS=72
